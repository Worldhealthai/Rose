# Copy to .env for local development (on Vercel, set these in the dashboard).

# Postgres connection string (e.g. from neon.tech). Use the direct connection
# string. Example:
#   postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/rose?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret used to sign login session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional: password for the admin account auto-created on first run.
# Defaults to "admin123" if not set. Username is always "admin".
# ADMIN_PASSWORD="choose-a-strong-password"
