# Copy to .env for local development (on Vercel, set these in the dashboard).

# Postgres connection string. From Supabase: Project Settings -> Database ->
# Connection string -> "Session pooler" (NOT the direct connection, which Vercel
# can't reach). Replace [YOUR-PASSWORD] with your database password. Example:
#   postgresql://postgres.abcd1234:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Secret used to sign login session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional: password for the admin account auto-created on first run.
# Defaults to "admin123" if not set. Username is always "admin".
# ADMIN_PASSWORD="choose-a-strong-password"
