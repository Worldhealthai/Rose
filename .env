# Rose Restaurant — environment variables.
#
# On Vercel: set these in Project → Settings → Environment Variables (those
# override this file). This committed file is only for running locally.

# Postgres connection string. For local dev, paste your Neon (or other) Postgres
# URL here. Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret used to sign login sessions. CHANGE THIS for production (set it in
# Vercel). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="7f21dc3d760739d79cff4cf2ad6eff0b6b0000d2dfd90843689684a76915db45"

# Optional: password for the auto-created admin on first run (default admin123).
# ADMIN_PASSWORD="choose-a-strong-password"
