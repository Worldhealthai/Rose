// Rose Restaurant — data model
// SQLite for zero-config self-hosting. Switch `provider` to "postgresql"
// and update DATABASE_URL to move to a managed database later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Staff member / login account. Admins are Employees with role = ADMIN.
/// role is "ADMIN" or "STAFF" (SQLite has no enum support).
/// Login is by `username` (case-insensitive, stored lowercased) + password.
model Employee {
  id           String         @id @default(cuid())
  name         String
  username     String         @unique
  email        String?
  avatar       String? // data-URL profile picture (small, resized client-side)
  passwordHash String
  role         String         @default("STAFF")
  position     String? // e.g. Chef, Waiter, Kitchen Porter
  hourlyRate   Float          @default(0)
  phone        String?
  active       Boolean        @default(true)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  chatLastReadAt DateTime? // last time this user opened the team chat

  shifts            Shift[]
  availability      Availability[]
  assignedTasks     Task[]             @relation("AssignedTasks")
  timeOff           TimeOff[]          @relation("TimeOff")
  expenses          Expense[]
  pushSubscriptions PushSubscription[]
  timeEntries       TimeEntry[]
  chatMessages      ChatMessage[]
}

/// A clock-in/clock-out record — actual hours worked.
model TimeEntry {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clockIn    DateTime
  clockOut   DateTime?
  createdAt  DateTime  @default(now())

  @@index([employeeId, clockIn])
  @@index([clockIn])
}

/// A message in the single team group chat.
model ChatMessage {
  id         String    @id @default(cuid())
  body       String
  authorId   String?
  author     Employee? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

/// A scheduled shift. employeeId null = open/unassigned slot.
model Shift {
  id         String    @id @default(cuid())
  date       DateTime // the calendar day of the shift (stored at 00:00 UTC)
  start      String // "HH:mm"
  end        String // "HH:mm"
  role       String? // what they're working as that shift
  notes      String?
  published  Boolean   @default(true)
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([date])
  @@index([employeeId])
}

/// A staff member's availability / preferences for a specific week.
/// weekStart is the Monday (UTC midnight) of the week the preference applies to.
model Availability {
  id             String    @id @default(cuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  weekStart      DateTime? // Monday of the week these preferences are for
  dayOfWeek      Int // 0 = Monday ... 6 = Sunday
  available      Boolean   @default(true)
  preferredStart String? // "HH:mm"
  preferredEnd   String? // "HH:mm"
  note           String?

  @@index([weekStart])
  @@index([employeeId, weekStart])
}

/// One row per trading day. Income split by channel.
model DailyIncome {
  id        String   @id @default(cuid())
  date      DateTime @unique // the trading day (stored at 00:00 UTC)
  zReport   Float    @default(0) // till / in-house takings from the Z report
  justEat   Float    @default(0)
  uberEats  Float    @default(0)
  deliveroo Float    @default(0)
  covers    Int? // optional: number of customers served
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A supplier you order from. Open as a profile to get contact details.
model Supplier {
  id          String    @id @default(cuid())
  name        String
  category    String? // e.g. Meat, Vegetables, Drinks
  contactName String?
  phone       String?
  email       String?
  website     String?
  address     String?
  notes       String? // order days, account number, min order, etc.
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
  expenses    Expense[]
}

/// A product/ingredient. Linked to a supplier. `needed` = on the order list.
model Product {
  id         String    @id @default(cuid())
  name       String
  unit       String? // kg, box, case, each...
  category   String?
  needed     Boolean   @default(false) // marked to be ordered
  neededNote String? // e.g. "2 cases" — how much to order
  parLevel   String? // optional target stock level
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([supplierId])
  @@index([needed])
}

/// Simple key/value app settings (restaurant name, delivery commission %, …).
model Setting {
  key   String @id
  value String
}

/// A business cost (stock, wages, rent, bills…). Used for profit = income − expenses.
model Expense {
  id         String    @id @default(cuid())
  date       DateTime
  category   String // Stock, Wages, Rent, Bills, Other
  amount     Float     @default(0)
  note       String?
  periodEnd  DateTime? // for Wages: the date this payment covers up to ("paid until")
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  employeeId String? // set for wage payments
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([date])
  @@index([employeeId])
}

/// A staff holiday / time-off request.
model TimeOff {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation("TimeOff", fields: [employeeId], references: [id], onDelete: Cascade)
  startDate  DateTime
  endDate    DateTime
  note       String?
  status     String   @default("PENDING") // PENDING / APPROVED / DECLINED
  createdAt  DateTime @default(now())

  @@index([employeeId])
  @@index([startDate])
}

/// A food-safety temperature reading (fridges/freezers) for compliance logs.
model TempLog {
  id        String   @id @default(cuid())
  date      DateTime
  unit      String // e.g. "Walk-in fridge", "Freezer 1"
  temp      Float
  byId      String?
  byName    String?
  createdAt DateTime @default(now())

  @@index([date])
}

/// An admin-facing alert created when staff do something (availability, time
/// off, flagging an order).
model Notification {
  id        String   @id @default(cuid())
  type      String // availability | timeoff | order
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
  @@index([createdAt])
}

/// A browser/phone push subscription (Web Push) for delivering notifications.
model PushSubscription {
  id         String    @id @default(cuid())
  endpoint   String    @unique
  p256dh     String
  auth       String
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
}

/// A recurring daily checklist task (e.g. "Clean beer keg").
model Task {
  id          String           @id @default(cuid())
  title       String
  area        String? // optional grouping: Kitchen, Bar, Front of house
  active      Boolean          @default(true)
  sortOrder   Int              @default(0)
  assigneeId  String? // null = everyone; otherwise a specific staff member
  assignee    Employee?        @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  completions TaskCompletion[]

  @@index([assigneeId])
}

/// Marks a task done on a particular day (the checklist resets each day).
model TaskCompletion {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  date       DateTime // the day (UTC midnight) it was completed for
  doneById   String?
  doneByName String?
  createdAt  DateTime @default(now())

  @@unique([taskId, date])
  @@index([date])
}

/// A menu item. When unavailable ("86'd"), staff are reminded to order the
/// ingredients and remove it from the delivery apps.
model MenuItem {
  id              String   @id @default(cuid())
  name            String
  category        String?
  price           Float?
  available       Boolean  @default(true)
  unavailableNote String? // what's needed to bring it back
  offJustEat      Boolean  @default(false)
  offUberEats     Boolean  @default(false)
  offDeliveroo    Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
